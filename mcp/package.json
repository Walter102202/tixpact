{
  "name": "@ticket-escrow/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local MCP server: an agent with its own capped testnet account that buys, transfers and claims tickets.",
  "scripts": {
    "agent:watch": "node dist/bin/watch.js",
    "build": "tsc -p tsconfig.build.json",
    "smoke": "node scripts/smoke.mjs",
    "start": "node dist/bin/serve.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@ticket-escrow/client": "workspace:*",
    "near-api-js": "7.5.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
