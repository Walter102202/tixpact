{
  "name": "ticket-escrow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Event tickets whose price stays reserved in a NEAR contract until an agreed verifier confirms the event.",
  "license": "MIT",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "gate": "bash scripts/gate.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@ticket-escrow/client": "workspace:*",
    "@types/node": "22.20.5",
    "near-api-js": "7.5.3",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
