{
  "name": "@ticket-escrow/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed reader, action builders, schemas and shared strings for the TixPact contract.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
